# Farsh Bazaar Environment Configuration
# Add required API keys below. In AI Studio, configure these values via the Secrets panel.

# Gemini API Key: Required for live AI Carpet Story generation and cultural motif analysis.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Farsh Bazaar Platform Key: Guild verification and sync token.
FARSH_BAZAR_API_KEY=YOUR_FARSH_BAZAR_API_KEY_HERE
